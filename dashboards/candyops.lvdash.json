{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "Headline KPIs",
      "queryLines": [
        "SELECT\n",
        "  MAX(CASE WHEN s.scenario_id = 'S1_NO_RECOVERY' THEN s.on_time_ready_rate_bags END) AS no_recovery_rate,\n",
        "  MAX(CASE WHEN s.scenario_id = 'S1_NO_RECOVERY' THEN s.bags_short END) AS bags_at_risk,\n",
        "  MAX(CASE WHEN s.scenario_id = 'S4_OVERTIME_AND_TRANSFER' THEN s.on_time_ready_rate_bags END) AS combined_rate,\n",
        "  (SELECT MAX(on_time_ready_rate_bags) FROM gold_sweep\n",
        "    WHERE sweep_name = 'film_delivery_date' AND option = 'overtime+transfer' AND param_value = '2026-10-28') AS combined_film_oct28_rate\n",
        "FROM gold_scenario_summary s"
      ]
    },
    {
      "name": "ds_options",
      "displayName": "Recovery options",
      "queryLines": [
        "SELECT\n",
        "  CASE scenario_id\n",
        "    WHEN 'S0_REFERENCE_NO_BREAKDOWN' THEN '0 No breakdown (reference)'\n",
        "    WHEN 'S1_NO_RECOVERY' THEN '1 No recovery'\n",
        "    WHEN 'S2_OVERTIME' THEN '2 Overtime'\n",
        "    WHEN 'S3_TRANSFER' THEN '3 Transfer'\n",
        "    WHEN 'S3B_TRANSFER_EARLY_WRAPPERS' THEN '3B Transfer, film Oct 27'\n",
        "    WHEN 'S4_OVERTIME_AND_TRANSFER' THEN '4 Overtime + transfer'\n",
        "  END AS option_label,\n",
        "  scenario_id,\n",
        "  bags_ready_on_time,\n",
        "  on_time_ready_rate_bags,\n",
        "  orders_fully_ready,\n",
        "  incremental_cost_usd,\n",
        "  incremental_ready_bags_vs_s1,\n",
        "  cost_per_incremental_ready_bag_usd,\n",
        "  primary_constraint\n",
        "FROM gold_scenario_summary\n",
        "ORDER BY option_label"
      ]
    },
    {
      "name": "ds_film",
      "displayName": "Film delivery sweep",
      "queryLines": [
        "SELECT\n",
        "  date_format(to_date(param_value), 'MMM d') AS film_arrives,\n",
        "  days_or_hours,\n",
        "  CASE option WHEN 'transfer' THEN 'Transfer only' ELSE 'Overtime + transfer' END AS option_label,\n",
        "  bags_ready_on_time,\n",
        "  on_time_ready_rate_bags,\n",
        "  incremental_cost_usd\n",
        "FROM gold_sweep\n",
        "WHERE sweep_name = 'film_delivery_date'\n",
        "ORDER BY days_or_hours"
      ]
    },
    {
      "name": "ds_otcap",
      "displayName": "Overtime cap sweep",
      "queryLines": [
        "SELECT\n",
        "  CONCAT(param_value, ' h') AS overtime_cap,\n",
        "  days_or_hours,\n",
        "  bags_ready_on_time,\n",
        "  on_time_ready_rate_bags,\n",
        "  incremental_cost_usd\n",
        "FROM gold_sweep\n",
        "WHERE sweep_name = 'overtime_cap_hours'\n",
        "ORDER BY days_or_hours"
      ]
    },
    {
      "name": "ds_spare",
      "displayName": "Southgate spare hours (transfer option)",
      "queryLines": [
        "SELECT\n",
        "  date_format(`date`, 'MMM d') AS day,\n",
        "  `date`,\n",
        "  recovery_runtime_hours AS ran_hours,\n",
        "  material_blocked_hours AS blocked_by_film_hours,\n",
        "  CASE WHEN timing_eligible THEN unused_hours ELSE 0 END AS unused_hours,\n",
        "  CASE WHEN timing_eligible THEN 0 ELSE spare_hours END AS too_late_hours\n",
        "FROM gold_recovery_capacity\n",
        "WHERE scenario_id = 'S3_TRANSFER' AND spare_hours > 0\n",
        "ORDER BY `date`"
      ]
    },
    {
      "name": "ds_orders",
      "displayName": "Orders at risk",
      "queryLines": [
        "SELECT\n",
        "  order_id,\n",
        "  customer_name,\n",
        "  sku_id,\n",
        "  date_format(ready_to_ship_deadline, 'MMM d') AS deadline,\n",
        "  MAX(order_qty_bags) AS ordered,\n",
        "  MAX(CASE WHEN scenario_id = 'S1_NO_RECOVERY' THEN ready_on_time_bags END) AS no_recovery,\n",
        "  MAX(CASE WHEN scenario_id = 'S2_OVERTIME' THEN ready_on_time_bags END) AS overtime,\n",
        "  MAX(CASE WHEN scenario_id = 'S3_TRANSFER' THEN ready_on_time_bags END) AS transfer,\n",
        "  MAX(CASE WHEN scenario_id = 'S4_OVERTIME_AND_TRANSFER' THEN ready_on_time_bags END) AS overtime_and_transfer\n",
        "FROM gold_order_fulfillment\n",
        "WHERE order_id IN (SELECT order_id FROM gold_order_fulfillment\n",
        "                   WHERE scenario_id = 'S1_NO_RECOVERY' AND at_risk_after_breakdown)\n",
        "GROUP BY order_id, customer_name, sku_id, ready_to_ship_deadline\n",
        "ORDER BY ready_to_ship_deadline, order_id"
      ]
    },
    {
      "name": "ds_checks",
      "displayName": "Integrity checks",
      "queryLines": [
        "SELECT\n",
        "  SUM(CASE WHEN status = 'PASS' THEN 1 ELSE 0 END) AS checks_passed,\n",
        "  COUNT(*) AS checks_total\n",
        "FROM (SELECT status FROM silver_quality_checks UNION ALL SELECT status FROM gold_validation_results)"
      ]
    }
  ],
